#!/usr/bin/env bash

prepare_branch_descriptions_path() {
  local toplevel_dir
  toplevel_dir=$(git rev-parse --show-toplevel) || return 1
  local my_box_dir="$toplevel_dir/$USER-my-box"
  local branch_descriptions_path="$my_box_dir/git-branch-descriptions"
  mkdir -p "$my_box_dir" || return 1
  touch "$branch_descriptions_path" || return 1
  echo "$branch_descriptions_path"
}

main() {
  local action
  action=$1
  case $action in
    "gitstashpopreset")
      gitstashpopreset
      ;;
    "gsp")
      gitstashpopreset
      ;;
    "a")
      ga
      ;;
    "add")
      ga
      ;;
    "b")
      gb
      ;;
    "branch")
      gb
      ;;
    "add-desc")
      adddesc "${@:2}"
      ;;
    "c")
      gbc "${@:2}"
      ;;
    "gbc")
      gbc "${@:2}"
      ;;
    "git-new-branch-via-stash")
      git-new-branch-via-stash "${@:2}"
      ;;
    "n")
      git-new-branch-via-stash "${@:2}"
      ;;
    "help")
      show_help
      ;;
    *)
      show_help
  esac
}

gitstashpopreset() { ## gsp|gitstashpopreset 一度 git stash したものを pop してコンフリクトを解消する
  git checkout --ours . && git reset && git checkout .
}

ga() { ## add|a git add する
  local selected
  selected=$(\git status -s | awk '$0 ~ /^.[^ ]/ || $0 ~ /^\?\?/' | fzf -m --ansi --preview="echo {} | awk '{print \$NF}' | xargs \git diff 2>/dev/null || echo {} | awk '{print \$NF}' | xargs cat" | awk '{print $NF}')
  if [[ -n "$selected" ]]; then
    git add `paste -s - <<< $selected`
  fi
  git status
}

gb() { ## git branch 一覧を表示する
  # fzf で選択したブランチに切り替える
  # fzf の左側にはブランチ名,あればdescriptionを表示する
  # descriptionがある場合はgit-branch-descriptions のbranchname,descriptionの形式から取り出せる
  local branch_descriptions_path
  branch_descriptions_path=$(prepare_branch_descriptions_path) || return 1
  local branches
  branches=$(git branch --format="%(refname:short)" --sort=-committerdate)
  local descriptions
  descriptions=$(cat "$branch_descriptions_path")
  local branch
  local description
  for branch in $branches; do
    # ダブルクォーテーションで囲まないと改行が消える
    description=$(echo "$descriptions" | awk -F, -v branch="$branch" '$1 == branch {print $2}')
    if [ -n "$description" ]; then
      echo "$branch $description"
    else
      echo $branch
    fi
  done | fzf | awk '{print $1}' | xargs git checkout
}

adddesc() { ## add-desc 現在のブランチに説明をつける
  local description="$@"
  if [ -z "$description" ]; then
    echo "description is required"
    return 1
  fi
  current_branch=$(git branch --show-current)
  if [ -z "$current_branch" ]; then
    echo "not a git repository"
    return 1
  fi
  local branch_descriptions_path
  branch_descriptions_path=$(prepare_branch_descriptions_path) || return 1
  # git-branch-descriptions にbranchname,descriptionの形式で保存する
  # すでにある場合は行ごと上書きする sed で置換する
  # 必須: スラッシュが入っているのでエスケープが必要

  sed -i -e "\#^$current_branch,#d" "$branch_descriptions_path"
  echo "$current_branch,$description" >> "$branch_descriptions_path"
}

gbc() { ## gbc|c git ブランチを作成
  # 第1引数にブランチ名を指定
  # 第2引数にdescriptionを指定
  local branch_name
  local description
  branch_name=$1
  # スペースを許可する
  description="${@:2}"
  # base_branch がなかったら現在のブランチを取得
  if [ -z "$2" ]; then
    echo "description is required"
    return 1
  fi
  if [ -z "$branch_name" ]; then
    echo "branch name is required"
    return 1
  fi
  local branch_descriptions_path
  branch_descriptions_path=$(prepare_branch_descriptions_path) || return 1
  git checkout -b $branch_name || return 1

  # git-branch-descriptions にbranchname,descriptionの形式で保存する
  echo "$branch_name,$description" >> "$branch_descriptions_path"
}

git-new-branch-via-stash() { ## n|git-new-branch-via-stash 現在のブランチを stash して新しいブランチを作成する
  local branch_name
  branch_name=$1
  if [ -z "$branch_name" ]; then
    echo "branch name is required"
    return 1
  fi
  local base_branch_name=$2
  if [ -z "$base_branch_name" ]; then
    base_branch_name="main"
  fi
  local is_stashed=false
  if ! git diff --quiet; then
    git stash && is_stashed=true
  fi
  git checkout $base_branch_name
  git pull
  git checkout -b $branch_name
  if [ "$is_stashed" = true ]; then
    git stash pop
  fi
}

show_help() { ## help|h ヘルプを表示する
  grep -E '{\s*##' $0 | awk 'BEGIN {FS="## "} {print $2}'
}

main "$@"
