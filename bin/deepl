#!/bin/bash

authKey=$DeepLKey # DeepLから認証キーを取得し、環境変数にセットしておく
toLang="JA"

arg=""
if [ -p /dev/stdin ]; then # パイプで標準入力が渡されたか
  # echo hoge | deepl
  arg=$(cat -) # 標準入力取得
else
  # deepl hoge
  arg=$* # 全引数取得
fi

text=$arg
# -sでダウンロード状況表示させない
# -Sでエラーは表示するように
# 認証キーは ps で見えないように、ヘッダーとして標準入力から渡す
resp=$(printf 'Authorization: DeepL-Auth-Key %s\n' "$authKey" | curl -sS https://api-free.deepl.com/v2/translate \
  -H @- \
  --data-urlencode "target_lang=${toLang}" \
  --data-urlencode "text=${text}")
# -rでダブルクオーテーションが消える
echo "$resp" | jq -r ".translations[].text"

exit 0
